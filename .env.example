# ─────────────────────────────────────────────
# ETHICAL FINDER — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────────

# Airtable (get from airtable.com → Account → Developer Hub)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_NAME=Brands

# Site URL (change to your Vercel domain after deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Form URL for brand submissions
NEXT_PUBLIC_SUBMIT_FORM_URL=https://forms.gle/your_form_id_here
